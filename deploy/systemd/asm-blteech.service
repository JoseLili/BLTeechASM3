[Unit]
Description=ASM BLTeech v3 receiver and SAME decoder
After=local-fs.target sound.target wm8960-audio-board-preload.service
Wants=sound.target
Requires=wm8960-audio-board-preload.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=blteech
Group=blteech
SupplementaryGroups=audio gpio i2c dialout
WorkingDirectory=/var/lib/asm-blteech
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/asm-blteech/current/src
ExecStart=/usr/bin/python3 /opt/asm-blteech/current/scripts/asm_daemon.py --state-file /var/lib/asm-blteech/receiver.json --diagnostic-log /var/lib/asm-blteech/diagnostics.jsonl --audit-log /var/lib/asm-blteech/audit.jsonl --notice-history /var/lib/asm-blteech/notices.jsonl
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=asm-blteech
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/asm-blteech

[Install]
WantedBy=multi-user.target
